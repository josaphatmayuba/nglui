{
  "name": "nglui",
  "version": "0.1.0",
  "description": "A small, dependency-free TypeScript utility library.",
  "keywords": [
    "typescript",
    "utils",
    "esm"
  ],
  "license": "MIT",
  "author": "josaphatmayuba",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/josaphatmayuba/nglui.git"
  },
  "bugs": {
    "url": "https://github.com/josaphatmayuba/nglui/issues"
  },
  "homepage": "https://github.com/josaphatmayuba/nglui#readme",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
